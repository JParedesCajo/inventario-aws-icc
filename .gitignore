
# Directorios y archivos temporales de Terraform
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfplan
*.tfplan.*
crash.log
crash.*.log

# Variables locales que pueden contener secretos
*.tfvars
*.tfvars.json
*.auto.tfvars
*.auto.tfvars.json
!*.tfvars.example

# No ignorar el archivo de bloqueo del proveedor
!.terraform.lock.hcl

# Archivos de credenciales
.env
.env.*
